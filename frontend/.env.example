# URL del backend en Render, SIN /api al final.
# En local se puede dejar vacía: el proxy de Vite redirige /api a localhost:3000.
VITE_API_URL=

# Supabase Auth (C13). Settings > API Keys del proyecto.
# La publishable key (antes "anon key") es pública por diseño: puede ir en el front.
# Sin estas dos variables la app corre sin login (desarrollo de C10–C12).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
