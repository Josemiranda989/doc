      "key": "caregiverId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "dependentId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "createdDependentId",
      "value": ""
    },
    {
      "key": "medicationId",
      "value": "aaaaaaaa-0000-4000-8000-000000000001"
    },
    {
      "key": "createdMedicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y status ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
