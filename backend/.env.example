PORT=3000
NODE_ENV=development

# Runtime: la app se conecta por acá.
# Local:    postgresql://postgres:postgres@localhost:5432/cuidar
# Supabase: Transaction pooler (puerto 6543) — Connect > ORMs > Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cuidar"

# CLI de Prisma (migrate): conexión directa o Session pooler (puerto 5432).
# En local puede ser la misma que DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cuidar"
