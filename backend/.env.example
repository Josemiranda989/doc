PORT=3000
NODE_ENV=development

# Runtime: la app se conecta por acá.
# Local:    postgresql://postgres:postgres@localhost:5432/cuidar
# Supabase: Transaction pooler (puerto 6543) — Connect > ORMs > Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cuidar"

# CLI de Prisma (migrate): conexión directa o Session pooler (puerto 5432).
# En local puede ser la misma que DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cuidar"

# ── Auth (C13) ──────────────────────────────────────────────
# URL del proyecto de Supabase (Settings > API). Con esta variable la API exige
# sesión: verifica el token de Supabase Auth en cada request.
# Sin ella, en desarrollo, todas las requests usan el cuidador del seed.
# En producción (NODE_ENV=production) es obligatoria: sin ella el server no arranca.
# SUPABASE_URL="https://<tu-proyecto>.supabase.co"

# Solo para proyectos viejos que firman con el "JWT secret" compartido (HS256).
# Los proyectos nuevos usan claves asimétricas y NO necesitan esto.
# SUPABASE_JWT_SECRET=""
